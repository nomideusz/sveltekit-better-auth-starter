# Every variable the app reads is declared in src/env.ts (ADMIN_* are read only
# by scripts/bootstrap-admin.mjs).
ORIGIN=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# First-run admin (created once, if that email does not exist yet)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public self-service sign-up at /auth/signup (default: off, admin creates accounts)
ALLOW_SIGNUP=false
# Email: EITHER an HTTP API (works on Railway Hobby, where SMTP ports are blocked)
RESEND_API_KEY=
# OR SMTP. Leave both unset locally: emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender for either transport. Resend: a verified-domain address, or leave empty
# for onboarding@resend.dev (delivers only to your own Resend account email).
SMTP_FROM=
SMTP_FROM_NAME=App
